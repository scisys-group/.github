targets.txt
targets_*.txt
domain_list.*
domain_matrix.*
audit_results/
scan_dumps/
recon_output/
*.csv
*.xlsx
*.parquet
report_*.json
summary_*.txt

# --- Python Environment & Runtime Artifacts ---
