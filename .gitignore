# --- Credentials, Secrets & Infrastructure ---
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
secrets/
credentials/
config.local.json
token.pickle

# --- Reconnaissance, Domain Dumps & Target Matrices ---
